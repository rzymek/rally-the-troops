//- vim:ts=4:sw=4:
doctype html
html
	head
		include head
		title= title.title_name
	body
		include header
		article
			h1= title.title_name

			div.logo
				+gamecover(title.title_id)

			| !{ title.about_html }

			p Read more about the game on #[a(href="https://boardgamegeek.com/boardgame/"+title.bgg) boardgamegeek.com].

			if user

				h2 Open
				if open_games.length > 0
					+gamelist(open_games, true)
				else
					p No open games right now.

				p
					a(href="/create/"+title.title_id) Create a new game

				if replacement_games.length > 0
					h2 Open (missing players)
					+gamelist(replacement_games, true)

				if ((seeds && seeds.length > 0) || (pools && pools.length > 0))
					h2 Tournaments
					+seedlist_stat(seeds, "Mini Cup")
					+poollist(pools, "Active")

				if active_games.length > 0
					h2 Recently active
					+gamelist(active_games, true)

				if finished_games.length > 0
					h2 Recently finished
					+gamelist(finished_games, true)

			else
				p.error You must log in to see games in progress!
